# zwslcore runtime settings
# Copy to .env. Never commit .env or real credentials.

OPENWEBUI_PORT=3000
OPENWEBUI_BIND_ADDRESS=127.0.0.1
LITELLM_PORT=4000
OLLAMA_PORT=11434

WEBUI_SECRET_KEY=REPLACE_ME_WEBUI_SECRET
LITELLM_MASTER_KEY=REPLACE_ME_LITELLM_MASTER_KEY
LITELLM_PROXY_ADMIN_NAME=zeaz
LITELLM_DB_PASSWORD=REPLACE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://litellm:REPLACE_ME_DATABASE_PASSWORD@host.docker.internal:5432/litellm
LITELLM_SALT_KEY=REPLACE_ME_LITELLM_SALT_KEY
PROVIDER_CLIENT_KEY=REPLACE_ME_PROVIDER_CLIENT_KEY
PROVIDER_PORT=8080
FREE_CLOUD_FALLBACK_ENABLED=false
ZEAZ_COST_POLICY=ZERO_COST_ONLY
# --- GGUF local models (imported into Ollama via Modelfile) ---
# Directory on the host containing .gguf files (must be accessible to the installer).
ZEAZ_GGUF_MODEL_DIR=/home/cvsz/zcoder/models
ZEAZ_GGUF_FAST_MODEL=qwen-1.5b-q4km.gguf
ZEAZ_GGUF_CODER_MODEL=qwen-7b-q4km.gguf

# Ollama model aliases created from GGUF files by the installer.
ZEAZ_FAST_MODEL=zwslcore-qwen-1.5b-q4km
ZEAZ_CODER_MODEL=zwslcore-qwen-7b-q4km
ZEAZ_REASONING_MODEL=zwslcore-qwen-7b-q4km
ZEAZ_LOCAL_MODEL=zwslcore-qwen-7b-q4km
ZEAZ_ENGINEERING_MODEL=auto
ZEAZ_ACCELERATOR_MODE=auto
ZEAZ_QUANTIZATION_PROFILE=Q4_K_M
ZEAZ_OLLAMA_CONTEXT_LENGTH=4096
ZEAZ_OLLAMA_FLASH_ATTENTION=false
ZEAZ_OLLAMA_KEEP_ALIVE=30m
ZEAZ_LITELLM_FAST_MODEL=ollama/zwslcore-qwen-1.5b-q4km
ZEAZ_LITELLM_CODER_MODEL=ollama/zwslcore-qwen-7b-q4km
ZEAZ_LITELLM_REASONING_MODEL=ollama/zwslcore-qwen-7b-q4km
OPENWEBUI_ENABLE_SIGNUP=false
OPENWEBUI_WEB_URL=http://localhost:3000
OPENWEBUI_SESSION_COOKIE_SECURE=false
OPENWEBUI_CORS_ALLOW_ORIGIN=http://127.0.0.1:3000

# Optional free/cloud providers. Leave empty to stay local-only.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Images may be overridden for controlled upgrades.
OLLAMA_IMAGE=ollama/ollama:0.40.2@sha256:b86366bb528bbf7f1424435d165028497a5b69bf6ddb4fa5a87102e2b79f44fb
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.104.2@sha256:3d88bd757134a00e8c00237b85a021ab1f6d54abb9c1df750f411dbe7256a500
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.4@sha256:9591b13f13843c7721c2b8eaf7382846c81b3ffe126526d1888d1fed50c6a33f

# S3 / Object Storage (SeaweedFS - local)
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY_ID=REPLACE_ME_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_ME_S3_SECRET_KEY
S3_BUCKET=REPLACE_ME_S3_BUCKET
S3_REGION=us-east-1
S3_USE_SSL=false
