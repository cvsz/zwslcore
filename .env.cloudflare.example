# Public reverse-proxy settings for the Cloudflare profile. This file has no secrets.
# Replace cloudflare-host.example.com with the real public hostname in your
# ignored .env.cloudflare copy; never commit a production hostname here.
OPENWEBUI_WEB_URL=https://cloudflare-host.example.com
OPENWEBUI_SESSION_COOKIE_SECURE=true
OPENWEBUI_ENABLE_SIGNUP=false
OPENWEBUI_CORS_ALLOW_ORIGIN=https://cloudflare-host.example.com;http://localhost:3000;http://127.0.0.1:3000
# Loopback ports for the Cloudflare overlay (kept clear of the local defaults).
PROVIDER_PORT=18086
OPENWEBUI_PORT=18087
